############## SCENARIO 1 ##################################################-
#################### 51 prb SA #############################################
sa_51prb(){
COMMAND="./nr-uesoftmodem \
-r 51 --numerology 1 --band 78 -C 3309960000 --ssb 222 --ue-txgain ${OPTIMAL_OTA_UE_TX_GAIN} --ue-rxgain ${OPTIMAL_OTA_UE_RX_GAIN} --ue-fo-compensation \
--sa --usrp-args "mgmt_addr=192.168.20.2,addr=192.168.20.2,clock_source=external,time_source=external" -A 45 \
--uecap_file ${CONFIGURATION_FOLDER}/uecap/uecap_ports2.xml \
-O ${CONFIGURATION_FOLDER}/${PLMNS["$SELECTED_PLMN"-1]}ue.conf ${NRSCOPE}"

# -A 45: Sometimes, the nrUE would keep repeating RA procedure because of Msg3 failure at the gNB. If it happens, add the -A option at the nrUE and/or gNB side, e.g., -A 45.
#This modifies the timing advance (in samples). Adjust +/-5 if the issue persists.
#################################################################################
}


################## SCENARIO 14 ##############################################
#################### SA mode band 66 #######################################
sa_band66(){
# band 66 
# FDD
# --numerology 1   (that means 30Khz subcarrier spacing)
# -r (Number of Physical Rsource Blocks PRBs)
# CO (Carrier Offset 400MHz)
# Carrier Frequency 2169080000 Hz
# --ssb (SSB subcarrier offset, substitutesthe older -s which is not valid now

COMMAND="./nr-uesoftmodem \
-r 106 --numerology 1 --band 66 -C 2169080000 --CO -400000000 --ssb 396 \
--ue-txgain ${OPTIMAL_OTA_UE_TX_GAIN} --ue-rxgain ${OPTIMAL_OTA_UE_RX_GAIN} --ue-fo-compensation \
--sa --usrp-args "addr=192.168.20.2,clock_source=internal,time_source=internal" -A 45 \
 --uecap_file ${CONFIGURATION_FOLDER}/uecap/uecap_ports1.xml \
-O ${CONFIGURATION_FOLDER}/${PLMNS["$SELECTED_PLMN"-1]}ue.conf ${NRSCOPE}"
}
############################################################################

######################## MAIN FUNCTION #####################################
function main() {

if [ "$*" == "" ]; then
    >&2 echo -e "${R}No arguments provided. Printing help message.${NOCOLOR}"
    print_help
    exit 1
fi
###########################################################

# check arguments

  until [ -z "$1" ]
  do
    case "$1" in
       -i | --info)
            echo "getting the version of OAI software..."
            sleep 1
            cd ${USERFOLDER}/openairinterface5g/
            echo -e "The version of the Open Air Interface is: ${G}$(git show | grep 'Merge branch' | cut -d "'" -f 2)${NOCOLOR}\n"
            exit 0
            shift;;
       -s | --scenario)
	    # check if scenario value is valid
            SELECTED_SCENARIO=$2
            if [[ ! $SELECTED_SCENARIO =~ $re ]] || [[ $SELECTED_SCENARIO -gt ${#SCENARIOS[@]} ]] || [[ $SELECTED_SCENARIO -le 0 ]] ; then
               echo -e "${R}selected senario is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
	    # check if core network is up, executing a ping to AMF ####
            #echo -e "checking connection to AMF..."
            #ping amf -c 1 > /dev/null
            #if [ $? -ne 0 ]; then
            #echo -e "${R}\nNo connection to AMF\n"
            #echo -e "start 5G core network prior to executing RAN ${NOCOLOR}\n"
            #exit 1
            #else 
            #echo -e "${G}OK...${NOCOLOR}"
            #fi 
            ###########################################################
            # check cpu state #########################################
            CPUCORES=$(lscpu | awk '/^CPU\(s\)\:/ {print $2}')
            for ((i=1; i < $CPUCORES+1 ; i++)); do
            CPU_INDEX=$(( $i -1 ))
            CURRENT_GOVERNOR=$(cat /sys/devices/system/cpu/cpu${CPU_INDEX}/cpufreq/scaling_governor)
            if [[ ${CURRENT_GOVERNOR} != "performance" ]] ; then 
            WARNING_FLAG=1
            fi
            done
            if [[ ${WARNING_FLAG} -eq 1 ]] ; then
            echo -e "${Y}WARNING:CPU governor not set to performance. COnsider running ${G}sudo ./cpustress${Y} to set maximum performance for all CPUs${NOCOLOR}"
            fi
            ###########################################################
            # switch to softmodem binary file folder ##################
            cd ${USERFOLDER}/openairinterface5g 
            source oaienv
            cd cmake_targets/ran_build/build
            OAI_FOLDER=$(pwd)
            ###########################################################
            shift 2;;
        -p | --plmn)
            SELECTED_PLMN=$2
            if [[ ! $SELECTED_PLMN =~ $re ]] || [[ $SELECTED_PLMN -gt ${#PLMNS[@]} ]] || [[ $SELECTED_PLMN -le 0 ]] ; then
               echo -e "${R}selected PLMN is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
            shift 2;;  
        -o | --scope)
            NRSCOPE="-d"
            shift;;  
        -l | --log)
            LOG=1
            shift;;      
	-h | --help)
            print_help
            exit 0;;
        -c | --command_line)
            CL=1
            shift;;  
        *) 
            exit
            ;;    
    esac
  done
############# compose command with arguments for the specific scenario ####
${SCENARIOS["$SELECTED_SCENARIO"-1]}   
###########################################################################
# check if script is run with sudo privilages
SCRIPTUSER=$(whoami)
if [[ $SCRIPTUSER = "root" ]] ; then 
echo -e "${R}you should not run script with sudo privilages\n${NOCOLOR}"
echo -e "${R}when using the -c parameter \n${NOCOLOR}"               
exit 1
fi
##### write to log file ################################################### 
if [[ ${LOG} -eq 1 ]]; then
COMMAND="${COMMAND} 2>&1 |tee ${LOGS_FOLDER}/ue_log_${LOG_FILE_TIMESTAMP}.txt"
fi
###########################################################################
##### add cpu affinity commannd in front of command to be executed ########
COMMAND="${CPU_AFFINITY}${COMMAND}"
echo -e $COMMAND | xclip 
echo -e $COMMAND > ${USER_SCRIPTS_FOLDER}/UE_COMMAND 

############# check if command is to be executed inside the script ########
#############   or copied to clipboard                          ###########
if [[ ${CL} -eq 1 ]]; then
            cd ${OAI_FOLDER} # move to binaries folder
            cat <<EOF
$(echo -e "${G}the command to start nr-softmodem was saved in file COMMAND in the current folder\n${NOCOLOR}")
-To view command before executing it type $(echo -e "${G}cat COMMAND${NOCOLOR}") in the command line. 
-To start UE softmodem copy and paste command to new terminal window in OAI binaries folder
EOF
            export COMMAND
            export OAI_FOLDER
            export MESSAGE="to execute nr-softmodem copy and paste the following command to command line or type \$(xclip -o):\n "           
            # execute bash in the same environment to keep the current directory
            gnome-terminal --working-directory=${OAI_FOLDER} -- bash -c 'echo -e "${MESSAGE} sudo $COMMAND" ; bash'        
else  
            # start execution of nr-softmodem for the selected scenario and PLMN   
            echo -e $(xclip -o) | sudo bash # execute command from clipboard     
fi  
##############################################################################  
###  change owner and group of newly created log file #############
if [[ ${LOG} -eq 1 ]]; then
cd ${LOGS_FOLDER}
sudo chown ${USER} ue_log_${LOG_FILE_TIMESTAMP}.txt
sudo chgrp ${USER} ue_log_${LOG_FILE_TIMESTAMP}.txt
fi
###################################################################

  }
 
  main "$@"









 



############################################################################

######################## MAIN FUNCTION #####################################
function main() {

if [ "$*" == "" ]; then
    >&2 echo -e "${R}No arguments provided. Printing help message.${NOCOLOR}"
    print_help
    exit 1
fi
###########################################################

# check arguments

  until [ -z "$1" ]
  do
    case "$1" in
       -i | --info)
            echo "getting the version of OAI software..."
            sleep 1
            cd ${USERFOLDER}/openairinterface5g/
            echo -e "The version of the Open Air Interface is: $(git show | grep 'Merge branch' | cut -d "'" -f 2)\n"
            exit 0;
            shift;;
       -s | --scenario)
	    # check if scenario value is valid
            SELECTED_SCENARIO=$2
            if [[ ! $SELECTED_SCENARIO =~ $re ]] || [[ $SELECTED_SCENARIO -gt ${#SCENARIOS[@]} ]] || [[ $SELECTED_SCENARIO -le 0 ]] ; then
               echo -e "${R}selected senario is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
            write_selected_scenario
	     # check if script is run with sudo privilages
	    SCRIPTUSER=$(whoami) 
            if [[ $SCRIPTUSER = "root" ]] ; then 
               echo -e "${R}you should not run script with sudo privilages\n${NOCOLOR}"
               echo -e "${R}try again without sudo \n${NOCOLOR}"               
            exit 1
            fi
	    # check if core network is up, executing a ping to AMF ####
            echo -e "checking connection to AMF...\n"
            ping amf -c 1 > /dev/null
            if [ $? -ne 0 ]; then
            echo -e "${R} No connection to AMF\n"
            echo -e "start 5G core network prior to executing RAN ${NOCOLOR}\n"
            exit 1
            fi 
            ###########################################################
            # check cpu state #########################################
            cpufreq-info | awk '/analyzing CPU/ || /current CPU frequency is/ {print}'
            ###########################################################
            shift 2;;
	-p | --plmn)
            SELECTED_PLMN=$2
            if [[ ! $SELECTED_PLMN =~ $re ]] || [[ $SELECTED_PLMN -gt ${#PLMNS[@]} ]] || [[ $SELECTED_PLMN -le 0 ]] ; then
               echo -e "${R}selected PLMN is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
            # change PLMN settings with gnbconfig script ##############
             ./gnbconfig -p ${SELECTED_PLMN}
            ###########################################################
            shift 2;;            
	-o | --scope)
            NRSCOPE="-d"
            shift;;  
	-t | --tracer)
	    # Tracer util usage with:--T_stdout 2
            # IMPORTANT !!!!!!
            # if tracer tool is not build 
            # goto home/openairinterface5g/common/utis/T/tracer and run make command to build all executables needed
            TRACER=1
            shift;;               
        -l | --log)
            LOG=1
            shift;;                    
	-h | --help)
            print_help
            exit 0;;
        *) 
            exit
            ;;
    esac
  done


############# compose command with arguments for the specific scenario ####
${SCENARIOS["$SELECTED_SCENARIO"-1]}
##### write to log file ################################################### 
if [[ ${LOG} -eq 1 ]] && [[ ${TRACER} -eq 0 ]]; then
COMMAND="${COMMAND} 2>&1 |tee ${LOGS_FOLDER}/gnb_log_${LOG_FILE_TIMESTAMP}.txt"
fi
##### use tracer tool ################################################### 
if [[ ${TRACER} -eq 1 ]]; then
COMMAND="${COMMAND} --T_stdout 2 ${USERFOLDER}/scripts/logs/gnb_log_${LOG_FILE_TIMESTAMP}.txt 2>&1"
fi
##### add cpu affinity commannd in front of command to be executed ########
COMMAND="${CPU_AFFINITY}${COMMAND}"
########## copy command to clipboard ######################################
echo -e "${COMMAND}" | xclip 
########## copy command to file COMMAND ###################################
echo ${COMMAND} > COMMAND
# switch to softmodem binary file folder ##################
echo ${USERFOLDER}
cd ${USERFOLDER}/openairinterface5g
source oaienv
cd ${GNB_EXEC_FOLDER}
# start execution of nr-softmodem for the selected scenario and PLMN   
echo -e "$(xclip -o)" | sudo bash  # execute command from clipboard    
###  change owner and group of newly created log file #############
if [[ ${LOG} -eq 1 ]]; then
cd ${LOGS_FOLDER}
sudo chown ${USER} gnb_log_${LOG_FILE_TIMESTAMP}.txt
sudo chgrp ${USER} gnb_log_${LOG_FILE_TIMESTAMP}.txt
fi
###################################################################
### set null value in SELECTED_SCENARIO VAR in gnbconfig.ini file #
echo "reseting selected scenario variable in gnbconfig.ini file.."
SELECTED_SCENARIO=""
write_selected_scenario
###################################################################
# end of script
  }

main "$@"

######################## MAIN FUNCTION #####################################
function main() {

if [ "$*" == "" ]; then
    >&2 echo -e "${R}No arguments provided. Printing help message.${NOCOLOR}"
    print_help
    exit 1
fi
###########################################################
# check if script is run with sudo privilages #############

SCRIPTUSER=$(whoami)
if [[ $SCRIPTUSER = "root" ]] ; then 
               echo -e "${R}you should not run script with sudo privilages\n${NOCOLOR}"
               echo -e "${R}when using the -c parameter \n${NOCOLOR}"               
    exit 1
fi
###########################################################
# check arguments

  until [ -z "$1" ]
  do
    case "$1" in
       -i | --info)
            echo "getting the version of OAI software..."
            sleep 1
            cd ${USERFOLDER}/openairinterface5g/
            echo -e "The version of the Open Air Interface is: ${G}$(git show | grep 'Merge branch' | cut -d "'" -f 2)${NOCOLOR}\n"
            exit 0;
            shift;;
       -s | --scenario)
	    # check if scenario value is valid./nr-softmodem -O /home/manolis/scripts/configuration/gnb.band78.sa.fr1.106PRB.usrpn310_TDD_2.conf --sa --usrp-tx-thread-config 1 --gNBs.[0].min_rxtxtime 6 -A 45 --L1s.[0].max_ldpc_iterations 20 --clock-source 1 --time-source 1 --MACRLCs.[0].ul_max_mcs 28  --thread-pool 0-7

            SELECTED_SCENARIO=$2
            if [[ ! $SELECTED_SCENARIO =~ $re ]] || [[ $SELECTED_SCENARIO -gt ${OTA_SCENARIOS} ]] || [[ $SELECTED_SCENARIO -le 0 ]] ; then
               echo -e "${R}selected senario is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
	    # check if core network is up, executing a ping to AMF ####
            echo -e "checking connection to AMF..."
            ping ${AMF_IP} -c 1 > /dev/null
            if [ $? -ne 0 ]; then
            echo -e "${R}\nNo connection to AMF\n"
            echo -e "start 5G core network prior to executing RAN ${NOCOLOR}\n"
            exit 1
            else 
            echo -e "${G}OK...${NOCOLOR}"
            fi 
            ###########################################################
            # check cpu state #########################################
            CPUCORES=$(lscpu | awk '/^CPU\(s\)/ {print $2}')
            for ((i=1; i < $CPUCORES+1 ; i++)); do
            CPU_INDEX=$(( $i -1 ))
            CURRENT_GOVERNOR=$(cat /sys/devices/system/cpu/cpu${CPU_INDEX}/cpufreq/scaling_governor)
            if [[ ${CURRENT_GOVERNOR} != "performance" ]] ; then 
            WARNING_FLAG=1
            fi
            done
            if [[ ${WARNING_FLAG} -eq 1 ]] ; then
            echo -e "${Y}WARNING:CPU governor not set to performance. Consider running ${G}sudo ./cpustress${Y} to set maximum performance for all CPUs${NOCOLOR}"
            fi
            shift 2;;
         -p | --plmn)
            SELECTED_PLMN=$2
            if [[ ! $SELECTED_PLMN =~ $re ]] || [[ $SELECTED_PLMN -gt ${#PLMNS[@]} ]] || [[ $SELECTED_PLMN -le 0 ]] ; then
               echo -e "${R}selected PLMN is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
            # change PLMN settings with gnbconfig script ##############
            ./gnbconfig -p ${SELECTED_PLMN}
            ###########################################################
            shift 2;;   
	-o | --scope)
            NRSCOPE="-d"
            shift;;       
	-t | --tracer)
	    # Tracer util usage with:--T_stdout 2
            # IMPORTANT !!!!!!
            # if tracer tool is not build 
            # goto home/openairinterface5g/common/utis/T/tracer and run make command to build all executables needed
            TRACER=1
            shift;;                                       
	-h | --help)
            print_help
            exit 0;;
        -c | --command_line)
            CL=1
            shift;;         
        -l | --log)
            # set LOG flag to 1 except in the case of running scenario 5
            if [[ ${SELECTED_SCENARIO} -ne 5 ]] ; then
            LOG=1
            fi
            shift;;                    
        *) 
            exit
            ;;
    esac
  done

############# compose command with arguments for the specific scenario ####
${SCENARIOS["$SELECTED_SCENARIO"-1]}  
##### write to log file ################################################### 
if [[ ${LOG} -eq 1 ]] && [[ ${TRACER} -eq 0 ]]; then
COMMAND="${COMMAND} 2>&1 |tee ${LOGS_FOLDER}/gnb_log_${LOG_FILE_TIMESTAMP}.txt"
fi
##### use tracer tool ################################################### 
if [[ ${TRACER} -eq 1 ]]; then
COMMAND="${COMMAND} --T_stdout 2 ${USERFOLDER}/scripts/logs/gnb_log_${LOG_FILE_TIMESTAMP}.txt 2>&1"
fi
##### add cpu affinity commannd in front of command to be executed ########
COMMAND="${CPU_AFFINITY}${COMMAND}"
########## copy command to clipboard ###################### 
echo -e "${COMMAND}" | xclip 
echo -e "$COMMAND" > COMMAND
###########################################################################
###########################################################
# switch to softmodem binary file folder ##################
cd ${USERFOLDER}/openairinterface5g 
source oaienv

############# check if command is to be executed inside the script ########
#############   or copied to clipboard                          ###########
if [[ ${CL} -eq 1 ]]; then
            cat <<EOF
$(echo -e "${G}the command to start nr-softmodem was saved in file COMMAND in the current folder\n${NOCOLOR}")
-To view command before executing it type $(echo -e "${G}cat COMMAND${NOCOLOR}") in the command line. 
-To start gNB softmodem copy and paste command to new terminal window in OAI binaries folder
EOF
            export COMMAND
            #export MESSAGE="to execute nr-softmodem copy and paste the following command to command line or type \$(xclip -o):\n "
            echo -e "sudo ${COMMAND}" > ${USERFOLDER}/scripts/COMMAND            
            # execute bash in the same environment to keep the current directory
            gnome-terminal --working-directory=${GNB_EXEC_FOLDER} -- bash -c 'echo -e "${MESSAGE} sudo $COMMAND" ; bash'         
else
# check if script is run with sudo privilages    
# start execution of nr-softmodem for the selected scenario and PLMN 
            write_selected_scenario # update value of SELECTED_SCENARIO in gnbconfig.ini file  
            cd ${GNB_EXEC_FOLDER}
            cat ${USER_SCRIPTS_FOLDER}/COMMAND | sudo bash  # execute command from clipboard     
fi    
###  change owner and group of newly created log file #############
if [[ ${LOG} -eq 1 ]] || [[ ${TRACER} -eq 1 ]]; then
cd ${LOGS_FOLDER}
sudo chown ${USER} gnb_log_${LOG_FILE_TIMESTAMP}.txt
sudo chgrp ${USER} gnb_log_${LOG_FILE_TIMESTAMP}.txt
fi
###################################################################
### set null value in SELECTED_SCENARIO var in gnbconfig.ini file #
echo -e "${G}reseting selected scenario variable in gnbconfig.ini file..${NOCOLOR}"
SELECTED_SCENARIO=""
write_selected_scenario
###################################################################
  }

main "$@"

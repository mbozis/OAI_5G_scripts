### set internal source for SDR in configuration file #########
set_internal(){
for file in ${CONFIGURATION_FOLDER}/*
do
sed -i 's/source=external/source=internal/g;s/source=gpsdo/source=internal/g' ${file}
done   
sed -i "/export FREQUENCY_SOURCE/c\export FREQUENCY_SOURCE=0" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export ONE_PPS_SOURCE/c\export ONE_PPS_SOURCE=0" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
}
###############################################################
### set external source for SDR in configuration file #########
set_external(){
for file in ${CONFIGURATION_FOLDER}/*
do
sed -i 's/source=internal/source=external/g;s/source=gpsdo/source=external/g' ${file}
done
sed -i "/export FREQUENCY_SOURCE/c\export FREQUENCY_SOURCE=1" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export ONE_PPS_SOURCE/c\export ONE_PPS_SOURCE=1" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
}
###############################################################

###############################################################
### set external source for SDR in configuration file #########
set_gpsdo(){
for file in ${CONFIGURATION_FOLDER}/*
do
sed -i 's/source=internal/source=gpsdo/g;s/source=external/source=gpsdo/g' ${file}
done
sed -i "/export FREQUENCY_SOURCE/c\export FREQUENCY_SOURCE=2" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export ONE_PPS_SOURCE/c\export ONE_PPS_SOURCE=2" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
}

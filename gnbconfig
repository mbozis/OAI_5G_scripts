###########################################################
function set_ip_addrs(){
#### Update LAN IP Addreesses of gNB and UE hosts ####################
echo -e "${Y}configuring ip addresses of hosts...${NOCOLOR}"
sleep 1
ping -c 1 -b ${LAN_B_ADDR} >/dev/null # ping broadcast address to update arp table
UE_HOST_IP=$(arp -n | grep ${UE_HOST_MAC} | awk '{print $1}')
sed -i "/export UE_HOST_IP=/c\export UE_HOST_IP=\"${UE_HOST_IP}\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
echo -e "UE host ip set to: ${G}${UE_HOST_IP}${NOCOLOR}"
GNB_HOST_IP=$(ip -br addr show | grep eno1 | awk '{print $3}' | cut -d'/' -f 1)
sed -i "/export GNB_HOST_IP=/c\export GNB_HOST_IP=\"${GNB_HOST_IP}\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
echo -e "GNB host ip set to: ${G}${GNB_HOST_IP}${NOCOLOR}"
######################################################################

####  find amf IP in oai-amf container ###############################
echo -e "${Y}configuring ip addresses of containers...${NOCOLOR}"
sleep 1
CN_DEPLOYED=$(ssh $CN_IP "docker ps" | wc -l)
if [ "$CN_DEPLOYED" = "1" ]; then
echo -e "${R}Core network containers are not deployed${NOCOLOR}"
exit 1
fi
AMF_IP=$(ssh $CN_IP "docker exec oai-amf ifconfig" | grep '''inet 192.168.''' | awk '{print $2}')
for file in ${CONFIGURATION_FOLDER}/*
do
sed -i "/amf_ip_address/c\     amf_ip_address         = ( { ipv4       = \"$AMF_IP\";" ${file}
done
echo -e "AMF ip set to ${G}$AMF_IP${NOCOLOR} in all configuration files"
CN_VERSION=$(ssh $CN_IP "docker ps" | grep oai-amf | cut -d':' -f 2 | cut -d' ' -f 1)
echo -e "OAI Core Network version is: ${G}$CN_VERSION${NOCOLOR}"
# change the UPF IP and the oai-ext-dn container ip in gnbconfig.ini file based on the running 5G core network version
if [ $CN_VERSION = "v1.5.1" ]; then
sed -i "/export UPF_IP=/c\export UPF_IP=\"192.168.70.134\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export OAI_EXT_DN_IP=/c\export OAI_EXT_DN_IP=\"192.168.70.135\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export AMF_IP=/c\export AMF_IP=\"192.168.70.132\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
echo -e "UPF container ip set to ${G}192.168.70.134${NOCOLOR} in gnbconfig.ini file"
echo -e "OAI_EXT_DN container ip set to ${G}192.168.70.135${NOCOLOR} in gnbconfig.ini file"
else
sed -i "/export UPF_IP=/c\export UPF_IP=\"192.168.70.135\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export OAI_EXT_DN_IP=/c\export OAI_EXT_DN_IP=\"192.168.70.131\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
sed -i "/export AMF_IP=/c\export AMF_IP=\"192.168.70.134\"; # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
echo -e "UPF container ip set to ${G}192.168.70.133${NOCOLOR} in gnbconfig.ini file"
echo -e "OAI_EXT_DN container ip set to ${G}192.168.70.131${NOCOLOR} in gnbconfig.ini file"
fi
####  find USRP device IP ###############################
echo -e "${Y}trying to configure management IP of USRP N310 SDR device...${NOCOLOR}"
GNB_USRP_MGMT_IP=$(uhd_find_devices --args="serial=${GNB_USRP_SERIAL}" | grep addr | grep -v mgmt_addr | awk '{print $2}' | tr -d '\n')
if [ ! -z "${GNB_USRP_MGMT_IP}" ]; then
sed -i "/export GNB_USRP_MGMT_IP=/c\export GNB_USRP_MGMT_IP=\"${GNB_USRP_MGMT_IP}\"  # controlled by gnbconfig -a" ${USER_SCRIPTS_FOLDER}/gnbconfig.ini
echo -e "USRP N310 mgmt IP ip set to ${G}${GNB_USRP_MGMT_IP}${NOCOLOR} in gnbconfig.ini file"
else
echo -e "${Y}WARNING: USRP N310 device could not be detected${NOCOLOR}"
fi
}

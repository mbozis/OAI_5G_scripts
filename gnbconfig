######################## MAIN FUNCTION #####################################
function main() {

if [ "$*" == "" ]; then
    >&2 echo -e "${R}No arguments provided. Printing help message.${NOCOLOR}"
    print_help
    exit 1
fi
###########################################################


# check arguments

  until [ -z "$1" ]
  do
    case "$1" in
        -a | --amf)
            set_ip_addrs       
            exit 0;
            shift;;
       -i | --info)
            echo "getting the version of OAI software..."
            sleep 1
            cd ${USERFOLDER}/openairinterface5g/
            echo -e "The version of the Open Air Interface is: ${G}$(git show | grep 'Merge branch' | cut -d "'" -f 2)${NOCOLOR}\n"
            exit 0;
            shift;;
       -s | --scenario)
	    # check if scenario value is valid
            SELECTED_SCENARIO=$2
            if [[ ! $SELECTED_SCENARIO =~ $re ]] || [[ $SELECTED_SCENARIO -gt ${#SCENARIOS[@]} ]] || [[ $SELECTED_SCENARIO -le 0 ]] ; then
               echo -e "${R}selected senario is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
           START_EDITOR=1 
           shift 2;;
       -e | --editor)
	    # check if scenario value is valid
            SELECTED_EDITOR=$2
            if [[ ! $SELECTED_EDITOR =~ $re ]] || [[ $SELECTED_EDITOR -gt ${#EDITORS[@]} ]] || [[ $SELECTED_EDITOR -le 0 ]] ; then
               echo -e "${R}selected editor is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
           shift 2;;
         -p | --plmn)
            SELECTED_PLMN=$2
            if [[ ! $SELECTED_PLMN =~ $re ]] || [[ $SELECTED_PLMN -gt ${#PLMNS[@]} ]] || [[ $SELECTED_PLMN -le 0 ]] ; then
               echo -e "${R}selected PLMN is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
	    set_plmn
            ###########################################################
            shift 2;;   
         -m | --mode)
            SELECTED_MODE=$2
            if [[ ! $SELECTED_MODE =~ $re ]] || [[ $SELECTED_MODE -gt 2 ]] || [[ $SELECTED_MODE -le 0 ]] ; then
               echo -e "${R}selected mode is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
	    set_mode_for_panel
            ###########################################################
            shift 2;;               
        -c | --core-net)
            config_net_ng
            shift;;

        --ul-max-mcs)
            # check if selected UL max MCS is valid
            SELECTED_UL_MAX_MCS=$2
            if [[ ! $SELECTED_UL_MAX_MCS =~ $re ]] || [[ ${SELECTED_UL_MAX_MCS} -gt 28 ]] || [[ ${SELECTED_UL_MAX_MCS} -lt 0 ]] ; then
               echo -e "${R}selected UL max MCS is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	         fi
            ###########################################################
            set_ul_max_mcs
            shift 2;;

         --dl-max-mcs)
            # check if selected UL max MCS is valid
            SELECTED_DL_MAX_MCS=$2
            if [[ ! $SELECTED_DL_MAX_MCS =~ $re ]] || [[ ${SELECTED_DL_MAX_MCS} -gt 28 ]] || [[ ${SELECTED_DL_MAX_MCS} -lt 0 ]] ; then
               echo -e "${R}selected DL max MCS is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	         fi
            ###########################################################
            set_dl_max_mcs
            shift 2;;

        --ul-min-mcs)
            # check if selected UL max MCS is valid
            SELECTED_UL_MIN_MCS=$2
            if [[ ! $SELECTED_UL_MIN_MCS =~ $re ]] || [[ ${SELECTED_UL_MIN_MCS} -gt 28 ]] || [[ ${SELECTED_UL_MIN_MCS} -lt 0 ]] ; then
               echo -e "${R}selected UL min MCS is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	         fi
            ###########################################################
            set_ul_min_mcs
            shift 2;;

         --dl-min-mcs)
            # check if selected UL max MCS is valid
            SELECTED_DL_MIN_MCS=$2
            if [[ ! $SELECTED_DL_MIN_MCS =~ $re ]] || [[ ${SELECTED_DL_MIN_MCS} -gt 28 ]] || [[ ${SELECTED_DL_MIN_MCS} -lt 0 ]] ; then
               echo -e "${R}selected DL min MCS is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	         fi
            ###########################################################
            set_dl_min_mcs
            shift 2;;

          -t | --att-tx)
            SELECTED_TX_VALUE=$2
            if [[ ! ${SELECTED_TX_VALUE} =~ $re ]] || [[ ${SELECTED_TX_VALUE} -gt 60 ]] || [[ ${SELECTED_TX_VALUE} -lt 0 ]] ; then
               echo -e "${R}selected value is not valid. Choose a value from 0 to 60 \n${NOCOLOR}"
               print_help
               exit 1 
	         fi
            set_att_tx
            ###########################################################
            shift 2;;     
        -r | --att-rx)
            SELECTED_RX_VALUE=$2
            if [[ ! ${SELECTED_RX_VALUE} =~ $re ]] || [[ ${SELECTED_RX_VALUE} -gt 60 ]] || [[ ${SELECTED_RX_VALUE} -lt 0 ]] ; then
               echo -e "${R}selected value is not valid. Choose a value from 0 to 30 \n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            set_att_rx 
            ###########################################################
            shift 2;;    
         --max-rxgain)
            SELECTED_MAX_RX_GAIN=$2
            if [[ ! ${SELECTED_MAX_RX_GAIN} =~ $re ]] || [[ ${SELECTED_MAX_RX_GAIN} -gt 75 ]] || [[ ${SELECTED_MAX_RX_GAIN} -lt 40 ]] ; then
               echo -e "${R}selected value is not valid. Choose a value from 40 to 75 for USRP N310 device \n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            set_max_rx_gain 
            ###########################################################
            shift 2;;    
         --pusch-snr)
            SELECTED_PUSCH_SNR=$2
            if [[ ! ${SELECTED_PUSCH_SNR} =~ $re ]] || [[ ${SELECTED_PUSCH_SNR} -gt 500 ]] || [[ ${SELECTED_PUSCH_SNR} -lt 100 ]] ; then
               echo -e "${R}selected value is not valid. Choose a value from 100 to 500 \n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            set_pusch_snr
            ###########################################################
            shift 2;; 
         --pucch-snr)
            SELECTED_PUCCH_SNR=$2
            if [[ ! ${SELECTED_PUCCH_SNR} =~ $re ]] || [[ ${SELECTED_PUCCH_SNR} -gt 500 ]] || [[ ${SELECTED_PUCCH_SNR} -lt 100 ]] ; then
               echo -e "${R}selected value is not valid. Choose a value from 100 to 500 \n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            set_pucch_snr
            ###########################################################
            shift 2;; 
         --ulsch-inactivity)
            SELECTED_ULSCH_INACTIVITY=$2
            if [[ ! ${SELECTED_ULSCH_INACTIVITY} =~ $re ]] || [[ ${SELECTED_ULSCH_INACTIVITY} -gt 30 ]] || [[ ${SELECTED_ULSCH_INACTIVITY} -lt 0 ]] ; then
               echo -e "${R}selected value is not valid. Choose a value from 0 to 30 for ulsch_max_frame_inactivity \n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            set_ulsch_inactivity
            ###########################################################
            shift 2;;             
       -E | --external-source)
            set_external
            shift;;
       -I | --internal-source)
            set_internal
            shift;;  
       -G | --gpsdo-source)
            set_gpsdo
            shift;;               
       -v | --view)
            VIEW_PARAMS=1 # Flag to denote viewing parameters instead of editing the whole configuration file            
            shift;; 
       -V | --view-ini)
            view_ini
            exit 0;;                              
	-h | --help)
            print_help
            exit 0;;
        *) 
            exit
            ;;
    esac
  done
if [[ $START_EDITOR -eq 1 ]] && [[ $VIEW_PARAMS -ne 1 ]]; then   
# edit configuration file of the selected scenario
#${SCENARIOS["$SELECTED_SCENARIO"-1]}
 if [[ "$SELECTED_EDITOR" -eq 2 ]]; then 
    ${EDITORS["$SELECTED_EDITOR"-1]}  ${CONFIGURATION_FOLDER}/${CONFIGURATIONS["$SELECTED_SCENARIO"-1]} &
 else
    ${EDITORS["$SELECTED_EDITOR"-1]}  ${CONFIGURATION_FOLDER}/${CONFIGURATIONS["$SELECTED_SCENARIO"-1]} 
 fi
fi 
# end of script

if [[ "$VIEW_PARAMS" -eq 1 ]]; then   
# view configuration file of the selected scenario
#${SCENARIOS["$SELECTED_SCENARIO"-1]}
view_config 
fi   
}

main "$@"




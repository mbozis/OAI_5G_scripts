########## view settings in configuration files ###############
########## for current or every scenario        ###############
view_config(){
if [[ -z "$SELECTED_SCENARIO" ]] ; then
  #---------- view all scenarios ------------------------------
  SCENARIO=1
  for file in ${CONFIGURATIONS[@]}
  do
  echo -e "scenario: ${G}${SCENARIO} ${NOCOLOR}Configuration file: ${G}${file}${NOCOLOR}"
  grep -E 'att_tx|att_rx|max_rxgain|plmn_list|tracking_area_code|pusch_TargetSNRx10|pucch_TargetSNRx10|ulsch_max_frame_inactivity' ${CONFIGURATION_FOLDER}/${file}
  ((SCENARIO++))
  echo "---------------------------------------------"
  done
else
  echo -e "scenario: ${G}${SELECTED_SCENARIO} ${NOCOLOR}Configuration file: ${G}${CONFIGURATIONS[${SELECTED_SCENARIO}-1]}${NOCOLOR}"
  grep -E 'att_tx|att_rx|max_rxgain|plmn_list|tracking_area_code|pusch_TargetSNRx10|pucch_TargetSNRx10|ulsch_max_frame_inactivity' $CONFIGURATION_FOLDER/${CONFIGURATIONS[${SELECTED_SCENARIO}-1]}
fi

}

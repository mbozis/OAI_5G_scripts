#!/bin/bash
# oai 5G testbed with USRP N310
# UOP
# DCS LAB Feb 2024
# Manolis Bozis
# script to edit configuration files
# load initial configuration values
source gnbconfig.ini

############################## VARIABLES SECTION #####################################

EDITORS=( "nano" "gedit" )
SELECTED_EDITOR=1 # default editor is nano
re='^[0-9]+$'    # integer value for selected scenario to be checked
PLMNS=( "PLMN_1_" "PLMN_2_" "PLMN_3_")
SELECTED_PLMN=1 # default PLMN is 00101
# PLMNs List ##############
# PLMN1  --> 00101
# PLMN1  --> 50501
# PLMN2  --> 20295
###########################
START_EDITOR=0 # Flag (default value is 0 --> do not edit configuration file)

######################################################################################

#### FUNCTION 1 print help message  ############
print_help(){
cat <<EOF
UOP - DCS LAB author Manolis Bozis 2023
Tool to edit configuration files for a particular scenario
using USRP N310 SDR device
or 2 hosts running OAI nrUE and nrgNB respectively.
the ethernet link between the host and SDR needs to be at least 10Gbps 

Usage:  $0 [OPTION]... [+VALUE] 
  -s, --scenario [value]   edit gnb softmodem configuration file for a specific scenario
                           number
                           value is from the following table
                           
                           ------------------------------------------------------------------
                          | 1 | standalone mode band 78 with 51prb  (SISO)                   |                          
                          | 2 | standalone mode band 78 with 106prb (SISO)                   |
                          | 3 | standalone mode band 78 with 133prb (SISO)                   |                      
                          | 4 | standalone mode band 78 with 162prb (SISO)                   |      
                          | 5 | standalone mode band 78 with 217prb (SISO)                   |  
                          | 6 | standalone mode band 77 with 273prb (SISO)                   |   
                          | 7 | standalone mode band 78 with 106prb TDD 1 slot configuration |
                          |   | with 7 DL, 2 UL, 1 FL slots, Periodicity=10 Slots            |
                          | 8 | standalone mode band 78 with 106prb TDD 2 slot configuration |
                          |   | with 2 DL, 1 UL, 1 FL slots, Periodicity=4 Slots             |                     
                          | 9 | standalone mode band 78 with 106prb (2x2 MIMO)               |
                          | 10| standalone mode band 78 with 133prb (2x2 MIMO)               |
                          | 11| standalone mode band 78 with 162prb (2x2 MIMO)               |     
                          | 12| standalone mode band 78 with 217prb (2x2 MIMO)               |  
                          | 13| standalone mode band 77 with 273prb (2x2 MIMO)               |
                          | 14| standalone mode band 66 with 106prb (SISO,FDD)               | 
                           ------------------------------------------------------------------
                          
  -p, --plmn               set PLMN and TAC settings
                           1 (default) --> 00101  TAC --> 0001
                           2           --> 50501  TAC --> 0001 
                           3           --> 20295  TAC --> 40960 
  --ul_max_mcs             set max MCS in Uplink                         
  -c, --core-net           configure network settings in gNB if Core Network is deployed in different host                         
  -e, --editor             choose editor, combined with -s argument
                           1 (default) --> nano
                           2           --> gedit                                                        
  -i, --info               show Open Air Interface software version
  -h, --help               print this help message
EOF
}
#################################################


set_plmn(){
case $SELECTED_PLMN in
    1)
    SELECTED_PLMN_VALUE="plmn_list = ({ mcc = 001; mnc = 01; mnc_length = 2; snssaiList = ({ sst = 1; }); });"
    SELECTED_TAC="tracking_area_code = 1;"
    ;;
    2)
    SELECTED_PLMN_VALUE="plmn_list = ({ mcc = 505; mnc = 01; mnc_length = 2; snssaiList = ({ sst = 1; }); });"
    SELECTED_TAC="tracking_area_code = 1;"
    ;;
    3)
    SELECTED_PLMN_VALUE="plmn_list = ({ mcc = 208; mnc = 95; mnc_length = 2; snssaiList = ({ sst = 1; }) });"
    SELECTED_TAC="tracking_area_code  =  40960"
    ;;
    *)
    exit
    ;;
esac
################### change plmn and tac for all configuration files ########    
for file in ${CONFIGURATION_FOLDER}/*
do
sed -i "/plmn_list/c\     ${SELECTED_PLMN_VALUE}" ${file}
sed -i "/tracking_area_code/c\     ${SELECTED_TAC}" ${file}
done
############################################################################
}


config_net_ng(){
################## change plmn and tac for all configuration files ########    


if [[ -z "${CN_IP}" || -z "${GNB_NIC_TO_CN}" ]]; then
 for file in ${CONFIGURATION_FOLDER}/*
 do
  sed -i "/GNB_INTERFACE_NAME_FOR_NG_AMF/c\        GNB_INTERFACE_NAME_FOR_NG_AMF            = \"demo-oai\";" ${file}
  sed -i "/GNB_IPV4_ADDRESS_FOR_NG_AMF/c\          GNB_IPV4_ADDRESS_FOR_NG_AMF            = \"192.168.70.129/24\";" ${file}
  sed -i "/GNB_INTERFACE_NAME_FOR_NGU/c\           GNB_INTERFACE_NAME_FOR_NGU            = \"demo-oai\";" ${file}
  sed -i "/GNB_IPV4_ADDRESS_FOR_NGU/c\             GNB_IPV4_ADDRESS_FOR_NGU            = \"192.168.70.129/24\";" ${file}
 done
else
 for file in ${CONFIGURATION_FOLDER}/*
 do
  sed -i "/GNB_INTERFACE_NAME_FOR_NG_AMF/c\        GNB_INTERFACE_NAME_FOR_NG_AMF            = \"${GNB_NIC_TO_CN}\";" ${file}
  sed -i "/GNB_IPV4_ADDRESS_FOR_NG_AMF/c\          GNB_IPV4_ADDRESS_FOR_NG_AMF            = \"${GNB_HOST_IP_CIDR}\";" ${file}
  sed -i "/GNB_INTERFACE_NAME_FOR_NGU/c\           GNB_INTERFACE_NAME_FOR_NGU            = \"${GNB_NIC_TO_CN}\";" ${file}
  sed -i "/GNB_IPV4_ADDRESS_FOR_NGU/c\             GNB_IPV4_ADDRESS_FOR_NGU            = \"${GNB_HOST_IP_CIDR}\";" ${file}
 done
fi

#sed -i "/tracking_area_code/c\     ${SELECTED_TAC}" ${file}

############################################################################
}


set_ul_max_mcs(){
sed -i "/export UL_MAX_MCS/c\export UL_MAX_MCS=${SELECTED_UL_MAX_MCS}" gnbconfig.ini
}

######################## MAIN FUNCTION #####################################
function main() {

if [ "$*" == "" ]; then
    >&2 echo -e "${R}No arguments provided. Printing help message.${NOCOLOR}"
    print_help
    exit 1
fi
###########################################################

# check arguments

  until [ -z "$1" ]
  do
    case "$1" in
       -i | --info)
            echo "getting the version of OAI software..."
            sleep 1
            cd ${USERFOLDER}/openairinterface5g/
            echo -e "The version of the Open Air Interface is: ${G}$(git show | grep 'Merge branch' | cut -d "'" -f 2)${NOCOLOR}\n"
            exit 0;
            shift;;
       -s | --scenario)
	    # check if scenario value is valid
            SELECTED_SCENARIO=$2
            if [[ ! $SELECTED_SCENARIO =~ $re ]] || [[ $SELECTED_SCENARIO -gt ${OTA_SCENARIOS} ]] || [[ $SELECTED_SCENARIO -le 0 ]] ; then
               echo -e "${R}selected senario is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
           START_EDITOR=1 
           shift 2;;
       -e | --editor)
	    # check if scenario value is valid
            SELECTED_EDITOR=$2
            if [[ ! $SELECTED_EDITOR =~ $re ]] || [[ $SELECTED_EDITOR -gt ${#EDITORS[@]} ]] || [[ $SELECTED_EDITOR -le 0 ]] ; then
               echo -e "${R}selected editor is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
           shift 2;;
         -p | --plmn)
            SELECTED_PLMN=$2
            if [[ ! $SELECTED_PLMN =~ $re ]] || [[ $SELECTED_PLMN -gt ${#PLMNS[@]} ]] || [[ $SELECTED_PLMN -le 0 ]] ; then
               echo -e "${R}selected PLMN is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
	    set_plmn
            ###########################################################
            shift 2;;   
        -c | --core-net)
            config_net_ng
            shift;;
        --ul_max_mcs)
            # check if selected UL max MCS is valid
            SELECTED_UL_MAX_MCS=$2
            if [[ ! $SELECTED_UL_MAX_MCS =~ $re ]] || [[ ${SELECTED_UL_MAX_MCS} -gt 27 ]] || [[ ${SELECTED_UL_MAX_MCS} -le 0 ]] ; then
               echo -e "${R}selected UL max MCS is not valid\n${NOCOLOR}"
               print_help
               exit 1 
	    fi
            ###########################################################
            set_ul_max_mcs
            shift 2;;
	-h | --help)
            print_help
            exit 0;;
        *) 
            exit
            ;;
    esac
  done
if [[ $START_EDITOR -eq 1 ]] ; then   
# edit configuration file of the selected scenario
#${SCENARIOS["$SELECTED_SCENARIO"-1]}
${EDITORS["$SELECTED_EDITOR"-1]}  ${CONFIGURATION_FOLDER}/${CONFIGURATIONS["$SELECTED_SCENARIO"-1]}
fi 
# end of script
  }

main "$@"



